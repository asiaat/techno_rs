// 1. Vaata kõiki indekseid (pane tähele, et sinu 'opilased' indeks
on juba siin!)
GET /_cat/indices?v
// 2. Lisa teine õpilane
POST /opilased/_doc/2
{
"eesnimi": "Juku",
"perenimi": "Juurikas",
"kursus": "IT-24",
"keskmine_hinne": 3.5
} /
/ 3. Lisa kolmas õpilane (automaatse ID-ga)
POST /opilased/_doc/
{
"eesnimi": "Kati",
"perenimi": "Karu",
"kursus": "KV-23",
"keskmine_hinne": 4.9
} /
/ 4. Otsi kõiki õpilasi, kes õpivad kursusel IT-24
GET /opilased/_search
{
"query": {
"match": {
"kursus": "IT-24"
5}
}
} /
/ 5. Otsi õpilasi, kelle keskmine hinne on vähemalt 4.5 (Range
päring)
GET /opilased/_search
{
"query": {
"range": {
"keskmine_hinne": {
"gte": 4.5
}
}
}
}
